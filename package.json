{
  "name": "luna-brand-hunt",
  "version": "0.1.0",
  "private": true,
  "description": "LUNA BRAND HUNT | ルナのブランド巡回ノート — Amazonのブランド商品を編集的に紹介するメディア",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
