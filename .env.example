# ============================================================================
# .env.example
# このファイルをコピーして .env.local を作り、値を入れてください。
#   cp .env.example .env.local
# 秘密値はこのファイルに書かないでください（空のままコミットします）。
# NEXT_PUBLIC_ で始まる値はブラウザへ露出します。秘密値を入れないでください。
# ============================================================================

# 本番URL。未設定の場合、canonical と OG URL を出力しません（架空のURLを出さないため）
NEXT_PUBLIC_SITE_URL=https://lunabrandhunt.com
NEXT_PUBLIC_SITE_NAME="THE BRAND EDIT"

# ---------------------------------------------------------------------------
# Supabase（Phase 2 で使用）
# 未設定の場合はモックデータで動作します。
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# サーバー専用。ブラウザから絶対に使わないこと。
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# 商品データの取得元
#   mock   … サンプルデータ（初期値）
#   amazon … Amazon Creators API（Phase 3 で実装）
# ---------------------------------------------------------------------------
PRODUCT_DATA_PROVIDER=mock

# ---------------------------------------------------------------------------
# Amazon Creators API（Phase 3 で使用）
# 変数名は実装時に公式資料で確認し、必要に応じて修正すること。
# ---------------------------------------------------------------------------
AMAZON_MARKETPLACE=JP
AMAZON_PARTNER_TAG=
AMAZON_CREATORS_CLIENT_ID=
AMAZON_CREATORS_CLIENT_SECRET=
AMAZON_CREATORS_API_ENDPOINT=

# ---------------------------------------------------------------------------
# 定期更新（Phase 4 で使用）
# Cron エンドポイントの認証に使う。十分に長いランダム文字列にすること。
# ---------------------------------------------------------------------------
CRON_SECRET=

# ---------------------------------------------------------------------------
# 管理画面（Phase 5 で使用）
# 管理者として許可するメールアドレス。カンマ区切り。
# ---------------------------------------------------------------------------
ADMIN_EMAIL_ALLOWLIST=
